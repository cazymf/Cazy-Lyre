global playing := false
global cursor := 1
global started := 0
global heldKeys := ""

XButton1::StartPlayback() ; Mouse4
XButton2::StopPlayback()  ; Mouse5
F12::ExitApp()            ; Escape untouched

StartPlayback(*) {
    global playing, cursor, started
    StopPlayback()
    cursor := 1
    started := A_TickCount
    playing := true
    SetTimer(PlaybackTick, 5)
}

StopPlayback(*) {
    global playing, heldKeys
    playing := false
    SetTimer(PlaybackTick, 0)
    if (heldKeys != "") {
        for , key in StrSplit(heldKeys)
            SendEvent("{" key " up}")
        heldKeys := ""
    }
}

PlaybackTick() {
    global notes, cursor, started, playing, heldKeys
    if (!playing)
        return
    elapsed := A_TickCount - started
    while (cursor <= notes.Length && notes[cursor][1] <= elapsed) {
        heldKeys := notes[cursor][2]
        for , key in StrSplit(heldKeys)
            SendEvent("{" key " down}")
        Sleep(22)
        for , key in StrSplit(heldKeys)
            SendEvent("{" key " up}")
        heldKeys := ""
        cursor += 1
    }
    if (cursor > notes.Length)
        StopPlayback()
}
